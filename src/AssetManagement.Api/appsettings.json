{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionStringName": "DefaultConnection"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=assets.db"
  },
  "Jwt": {
    "Issuer": "asset-management-api",
    "Audience": "asset-management-clients",
    "SigningKey": "DEV-ONLY-signing-key-replace-via-Azure-Key-Vault-in-production",
    "ExpiryMinutes": 60
  },
  "Seed": {
    "SampleData": false
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "Swagger": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
